{
  "name": "@toryr/jobpipe",
  "version": "0.1.0",
  "description": "Your job search as a pipeline: poll employer job boards directly, screen against your own rules, have Claude judge what survives, tailor a fact-checked resume, and track it. Node 22 + SQLite, zero dependencies.",
  "keywords": [
    "job-search",
    "greenhouse",
    "lever",
    "ashby",
    "workday",
    "claude",
    "cli",
    "sqlite"
  ],
  "author": "Tory Radtke (https://toryradtke.com)",
  "license": "MIT",
  "homepage": "https://github.com/toryradtke-star/jobpipe#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toryradtke-star/jobpipe.git"
  },
  "bugs": {
    "url": "https://github.com/toryradtke-star/jobpipe/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "jobpipe": "dist/bin/jobpipe.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "poll": "node --disable-warning=ExperimentalWarning bin/jobpipe.ts poll",
    "screen": "node --disable-warning=ExperimentalWarning bin/jobpipe.ts screen",
    "judge": "node --disable-warning=ExperimentalWarning bin/jobpipe.ts judge",
    "report": "node --disable-warning=ExperimentalWarning bin/jobpipe.ts report",
    "verify": "node --disable-warning=ExperimentalWarning bin/jobpipe.ts verify",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "build": "node --disable-warning=ExperimentalWarning scripts/build.ts",
    "prepublishOnly": "npm test && npm run build"
  }
}
