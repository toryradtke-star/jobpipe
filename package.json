{
  "name": "jobpipe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A personal job-posting collector: polls company ATS boards directly, screens against your own rules, and judges what survives.",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "jobpipe": "./bin/jobpipe.ts"
  },
  "scripts": {
    "poll": "node --disable-warning=ExperimentalWarning bin/jobpipe.ts poll",
    "screen": "node --disable-warning=ExperimentalWarning bin/jobpipe.ts screen",
    "judge": "node --disable-warning=ExperimentalWarning bin/jobpipe.ts judge",
    "report": "node --disable-warning=ExperimentalWarning bin/jobpipe.ts report",
    "verify": "node --disable-warning=ExperimentalWarning bin/jobpipe.ts verify",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\""
  }
}
